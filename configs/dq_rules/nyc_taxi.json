      "checks": [
        {
          "type": "null_percentage",
          "column": "tpep_pickup_datetime",
          "max_null_pct": 0
        },
        {
          "type": "range",
          "column": "trip_distance",
          "minimum": 0
        }
      ]
    },
    {
      "name": "gold_monthly_summary",
      "path": "data/gold/nyc_taxi/gold_monthly_summary",
      "checks": [
        {
          "type": "duplicate_percentage",
          "columns": ["_source_month"],
